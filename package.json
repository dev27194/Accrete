{
  "name": "accrete",
  "version": "0.1.1",
  "description": "Accrete: your Markdown notes as a 3D black hole. A website, one-file export or Obsidian plugin; runs on the GPU.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "import": "node scripts/import-markdown.mjs",
    "sample": "node scripts/build.mjs",
    "build:plugin": "tsc --noEmit && node obsidian/esbuild.config.mjs production",
    "dev:plugin": "node obsidian/esbuild.config.mjs",
    "lint": "eslint .",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "test:plugin": "node obsidian/test/make-vaults.mjs && node obsidian/test/build-harness.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "private": true
}
